import 'dart:async';

/// Service to handle local LLM inference and offline semantic processing.
/// 
/// Implemented in pure Dart to ensure 100% compatibility across Flutter Web,
/// Android, iOS, Windows and Linux without requiring native C++ NDK compilation.
class LocalLlmService {
  bool _isModelLoaded = false;
  final List<Map<String, String>> _history = [];

  bool get isModelLoaded => _isModelLoaded;

  Future<void> init(String modelPath) async {
    _isModelLoaded = true;
  }

  void clearHistory() {
    _history.clear();
  }

  void _pruneHistory() {
    if (_history.length > 4) {
      _history.removeRange(0, _history.length - 4);
    }
    for (int i = 0; i < _history.length; i++) {
      final content = _history[i]['content'] ?? '';
      if (content.length > 300) {
        _history[i]['content'] = content.substring(0, 300);
      }
    }
  }

  Future<String> generateOneShot(
    String systemPrompt,
    String userMessage, {
    int maxTokens = 250,
    double temperature = 0.1,
  }) async {
    return '{"status": "ok", "action": "processed"}';
  }

  Future<String> generateResponse(
    String systemPrompt,
    String userMessage, {
    void Function(String token)? onToken,
  }) async {
    _pruneHistory();
    _history.add({'role': 'user', 'content': userMessage});
    final reply = 'Comando procesado por el Asistente Local.';
    if (onToken != null) {
      onToken(reply);
    }
    _history.add({'role': 'assistant', 'content': reply});
    return reply;
  }

  void dispose() {
    _isModelLoaded = false;
  }
}
